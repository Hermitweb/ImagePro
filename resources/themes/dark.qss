/* ImagePro Dark Theme - Design Token Based */

QWidget {
    background-color: #1E1E1E;
    color: #E6E6E6;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 11pt;
}

QMainWindow,
QDialog {
    background-color: #1E1E1E;
    color: #E6E6E6;
}

/* Menu */
QMenuBar {
    background-color: #1E1E1E;
    color: #E6E6E6;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QMenu {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected,
QMenu::item:hover {
    background-color: rgba(74, 158, 255, 0.15);
    color: #4A9EFF;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 6px 12px;
}

/* Toolbar */
QToolBar {
    background-color: #1E1E1E;
    border: none;
    spacing: 8px;
    padding: 8px;
}

QToolBar::separator {
    width: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #E6E6E6;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QToolButton:checked {
    background-color: rgba(74, 158, 255, 0.15);
    border-color: #4A9EFF;
    color: #4A9EFF;
}

/* Primary button */
QPushButton {
    background-color: #4A9EFF;
    color: #FFFFFF;
    border: 1px solid #4A9EFF;
    border-radius: 6px;
    padding: 0 16px;
    min-height: 34px;
    max-height: 34px;
    outline: none;
}

QPushButton:hover {
    background-color: #5CABFF;
    border-color: #5CABFF;
}

QPushButton:pressed {
    background-color: #3D8BE6;
    border-color: #3D8BE6;
}

QPushButton:disabled {
    background-color: #555555;
    border-color: #555555;
    color: #999999;
}

QPushButton:default {
    background-color: #4A9EFF;
    border-color: #4A9EFF;
}

/* Secondary button */
QPushButton.secondary-button {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.24);
}

QPushButton.secondary-button:hover {
    background-color: #3C3C3C;
    border-color: rgba(255, 255, 255, 0.36);
}

QPushButton.secondary-button:pressed {
    background-color: #2D2D30;
}

/* Danger button */
QPushButton.danger-button {
    background-color: #F85149;
    color: #FFFFFF;
    border: 1px solid #F85149;
}

QPushButton.danger-button:hover {
    background-color: #FF6B6B;
    border-color: #FF6B6B;
}

QPushButton.danger-button:pressed {
    background-color: #D43D3D;
    border-color: #D43D3D;
}

/* Icon button */
QPushButton.icon-button {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton.icon-button:hover {
    background-color: #3C3C3C;
    border-color: rgba(255, 255, 255, 0.24);
}

QPushButton.icon-button:pressed {
    background-color: #2D2D30;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 0 8px;
    min-height: 30px;
    selection-background-color: #4A9EFF;
}

QTextEdit,
QPlainTextEdit {
    padding: 8px;
    min-height: 60px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 2px solid #4A9EFF;
    padding: 0 7px;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    padding: 7px;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #2D2D30;
    color: #707070;
    border-color: rgba(255, 255, 255, 0.06);
}

/* Error state */
QLineEdit.error,
QTextEdit.error,
QPlainTextEdit.error,
QSpinBox.error,
QDoubleSpinBox.error,
QComboBox.error,
QDateEdit.error,
QTimeEdit.error,
QDateTimeEdit.error {
    border: 2px solid #F44336;
    padding: 0 7px;
}

QTextEdit.error,
QPlainTextEdit.error {
    padding: 7px;
}

QLineEdit.error:focus,
QTextEdit.error:focus,
QPlainTextEdit.error:focus,
QSpinBox.error:focus,
QDoubleSpinBox.error:focus,
QComboBox.error:focus,
QDateEdit.error:focus,
QTimeEdit.error:focus,
QDateTimeEdit.error:focus {
    border: 2px solid #F44336;
}

/* Combo box */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 6px;
    image: url(:/icons/icons/arrow-down-light.svg);
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    selection-background-color: rgba(74, 158, 255, 0.15);
    selection-color: #4A9EFF;
    padding: 4px;
}

/* Spin box buttons */
QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 18px;
    background-color: transparent;
    border: none;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 10px;
    height: 6px;
    image: url(:/icons/icons/arrow-up-light.svg);
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 10px;
    height: 6px;
    image: url(:/icons/icons/arrow-down-light.svg);
}

/* Group box */
QGroupBox {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    margin-top: 12px;
    padding: 24px 16px 16px 16px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -2px;
    padding: 0 8px;
    color: #E6E6E6;
}

/* List views */
QListView,
QTreeView,
QTableView {
    background-color: #252526;
    color: #E6E6E6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    outline: none;
    selection-background-color: transparent;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: rgba(74, 158, 255, 0.15);
    color: #4A9EFF;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListView::item:selected:hover,
QTreeView::item:selected:hover,
QTableView::item:selected:hover {
    background-color: rgba(74, 158, 255, 0.22);
}

QHeaderView::section {
    background-color: #2D2D30;
    color: #E6E6E6;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 8px;
    font-weight: 500;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.24);
    border-radius: 5px;
    min-height: 32px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.36);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.24);
    border-radius: 5px;
    min-width: 32px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.36);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status bar */
QStatusBar {
    background-color: #252526;
    color: #A0A0A0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
}

QStatusBar::item {
    border: none;
}

/* Labels */
QLabel {
    background-color: transparent;
    color: #E6E6E6;
}

QLabel.secondary {
    color: #A0A0A0;
}

/* Slider */
QSlider::groove:horizontal {
    height: 6px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #4A9EFF;
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: #252526;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
    margin: -5px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #3C3C3C;
    border-color: rgba(255, 255, 255, 0.36);
}

QSlider::handle:horizontal:pressed {
    background-color: #4A9EFF;
    border-color: #4A9EFF;
}

/* Progress bar */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.12);
    color: #E6E6E6;
    border: none;
    border-radius: 4px;
    text-align: center;
    min-height: 8px;
    max-height: 8px;
    font-size: 9pt;
}

QProgressBar::chunk {
    background-color: #4A9EFF;
    border-radius: 4px;
}

/* Checkbox and Radio */
QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #E6E6E6;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #252526;
    border: 1px solid rgba(255, 255, 255, 0.24);
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: rgba(255, 255, 255, 0.36);
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #4A9EFF;
    border-color: #4A9EFF;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #2D2D30;
    border-color: rgba(255, 255, 255, 0.12);
}

/* Tabs */
QTabWidget::pane {
    background-color: #252526;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #A0A0A0;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 16px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #4A9EFF;
    border-bottom-color: #4A9EFF;
}

QTabBar::tab:hover:!selected {
    color: #E6E6E6;
    background-color: rgba(255, 255, 255, 0.05);
}

/* Splitter */
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.12);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Tooltips */
QToolTip {
    background-color: #E6E6E6;
    color: #1E1E1E;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 10pt;
}

/* Frame */
QFrame {
    border: none;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    border: 1px solid rgba(255, 255, 255, 0.12);
}

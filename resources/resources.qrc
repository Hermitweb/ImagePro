<RCC>
    <qresource prefix="/themes">
        <file alias="light.qss">themes/light.qss</file>
        <file alias="dark.qss">themes/dark.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file>icons/app.png</file>
        <file>icons/app.svg</file>
        <file>icons/arrow-down-dark.svg</file>
        <file>icons/arrow-down-light.svg</file>
        <file>icons/arrow-up-dark.svg</file>
        <file>icons/arrow-up-light.svg</file>
        <file>icons/tools/tool-stitch.svg</file>
        <file>icons/tools/tool-convert.svg</file>
        <file>icons/tools/tool-compress.svg</file>
        <file>icons/tools/tool-watermark.svg</file>
        <file>icons/tools/tool-edit.svg</file>
        <file>icons/tools/tool-resize.svg</file>
        <file>icons/tools/tool-batch.svg</file>
        <file>icons/tools/tool-pdf.svg</file>
        <file>icons/tools/tool-results.svg</file>
        <file>icons/tools/tool-add.svg</file>
        <file>icons/tools/tool-remove.svg</file>
        <file>icons/tools/tool-clear.svg</file>
    </qresource>
    <qresource prefix="/i18n">
        <file alias="ImagePro_zh_CN.qm">../translations/ImagePro_zh_CN.qm</file>
        <file alias="ImagePro_en.qm">../translations/ImagePro_en.qm</file>
    </qresource>
</RCC>
